# ---- Server ----
NODE_ENV=development
PORT=3000

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/car_marketplace
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/car_marketplace?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/car_marketplace

# ---- Sessions ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string
SESSION_NAME=cm.sid
# Session lifetime in milliseconds (default: 7 days)
SESSION_TTL_MS=604800000

# ---- Behaviour ----
# Max page size accepted by the paginated search endpoints
MAX_PAGE_SIZE=50
# Set to 1 behind a TLS-terminating proxy so secure cookies are issued
TRUST_PROXY=0
